rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper function to check ownership
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Users can only read their own profile, and can only create their own profile.
    match /users/{userId} {
      allow read, update, delete: if isOwner(userId);
      allow create: if request.auth != null;
    }

    // All user-specific collections and sub-documents are only accessible by the owner.
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // Shopify store lookup mapping: Authenticated users can read or map their own store
    match /shopify_stores/{shop} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Shopify sync jobs: Authenticated merchants can view job status; updates are handled by backend sync engine
    match /shopify_sync_jobs/{jobId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Sensitive server-managed Shopify infrastructure collections:
    // Exclusively managed on the server via privileged Firebase Admin SDK (which bypasses security rules).
    // Direct client-side reading or tampering is strictly denied.
    match /shopify_connections/{shop} {
      allow read, write: if false;
    }

    match /shopify_oauth_states/{nonce} {
      allow read, write: if false;
    }

    match /shopify_processed_webhooks/{id} {
      allow read, write: if false;
    }

    match /shopify_outgoing_operations/{opId} {
      allow read, write: if false;
    }
  }
}
